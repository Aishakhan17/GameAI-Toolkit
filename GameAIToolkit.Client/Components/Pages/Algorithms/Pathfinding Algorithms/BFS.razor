@page "/algorithms/pathfinding-algorithms/bfs"
@using GameAIToolkit.Client.Components.UI.Graphs
@layout PlaygroundLayout
@rendermode InteractiveWebAssembly

<PageTitle>Breadth First Search</PageTitle>
<div class="lesson-page">
    <header class="lesson-header">
        <h2 class="lesson-title">Breadth First Search</h2>
        <div class="tab-row">
            <button class="btn btn-primary" @onclick="ToggleDisplayMode" aria-label="Visualize">Visualize</button>
            <button class="btn btn-primary" @onclick="ToggleDisplayMode" aria-label="Explain">Explain</button>
        </div>
    </header>

    @if (_explain)
    {
        <div class="lesson-body topic-intro">
            <h1 class="font-code text-align-center">Overview</h1>
            <p class="font-body text-align-center">Breadth First Search (BFS) is ...</p>
        </div>
    }

    @if (_visualize)
    {
        <div class="lesson-body">
            <ForceDirectedGraph />
        </div>
    }
</div>

@code {
    bool _visualize = true;
    bool _explain = false;

    private void ToggleDisplayMode()
    {
        Console.WriteLine("toggling mode");
        _explain = !_explain;
        _visualize = !_visualize;
        Console.WriteLine($"{_explain} {_visualize}");

    }
    

}