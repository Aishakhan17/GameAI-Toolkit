
@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <a class="brand font-display" href="/">
            Aisha's Laboratory
        </a>

        <nav class="main-nav" aria-label="Main navigation">
            <NavLink href="/algorithms" class="nav-link">
                Algorithms
            </NavLink>

            <NavLink href="/games" class="nav-link">
                Games
            </NavLink>

            <NavLink href="/about" class="nav-link">
                About
            </NavLink>
        </nav>

        <div class="header-actions">
            <button class="theme-toggle"
                    @onclick="ToggleTheme"
                    aria-label="Toggle dark mode">
                @(_isDarkMode ? "☀ Light" : "☾ Dark")
            </button>

            <a class="github-link"
               href="https://github.com/Aishakhan17?tab=repositories"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="GitHub repositories">
                GitHub ↗
            </a>
        </div>
    </header>

    <main class="main-body">
        @Body
    </main>
</div>

@code {
    private bool _isDarkMode;

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }
}
