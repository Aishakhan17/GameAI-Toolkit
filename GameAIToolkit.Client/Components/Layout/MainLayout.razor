@inherits LayoutComponentBase;

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="@CustomThemes.CustomTheme.Spacelabtheme"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>
<MudLayout>
    <MudAppBar Elevation="1">
        <h1 class="font-display">Aisha's Laboratory</h1>
        <MudSpacer />
        <MudButton Href="/algorithms">Algorithms</MudButton>
        <MudButton>Games</MudButton>
        <MudButton>About</MudButton>
        <MudSwitch @bind-Value="_isDarkMode" Color="Color.Primary" Class="ma-4" T="bool" Label="Toggle Light/Dark Mode" />
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/Aishakhan17?tab=repositories" Target="_blank" />
    </MudAppBar>
    <div class="main-body">
            @Body
    </div>
</MudLayout>

@code{
    private bool _isDarkMode = false;
    private bool _isBrowser;
    protected override void OnInitialized()
    {
        _isBrowser = OperatingSystem.IsBrowser();
        Console.WriteLine($"_isBrowser {_isBrowser}");
    }


}