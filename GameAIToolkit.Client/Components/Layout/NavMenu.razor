@using MudBlazor.Charts
<div class="side-nav">
    @foreach (var entry in topics)
    {
        <div class="flex-column p-10 ml-10">
            <details open>                    
                <summary>
                    <span class="flex-row">
                        @entry.Key
                        <svg xmlns="http://www.w3.org/2000/svg"  width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-right preview-icon"><path d="m9 18 6-6-6-6"/></svg>
                    </span>
                </summary>
                @* </div> *@
                <div class="ml-5">
                    @foreach (var kvp in @entry.Value) {
                        <ul>
                            <li>
                                <a class="font-body text-dark mt-5" href="@kvp.Value">
                                    @kvp.Key
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </details>
        </div>
    }
</div>

@code {
    public Dictionary<string, Dictionary<string, string>> topics {get; set;}

    protected override void OnInitialized()
    {
        initializeTopicList();
    }
    private void initializeTopicList()
    {
        topics = new();
        topics.Add("Data Structures", new Dictionary<string, string>());
        topics["Data Structures"].Add("Array List",  "/algorithms/data-structures/array-list");
        topics["Data Structures"].Add("Linked Lists", "/algorithms/data-structures/linked-list");
        topics["Data Structures"].Add("Doubly Linked Lists", "/algorithms/data-structures/doubly-linked-list");
        topics["Data Structures"].Add("Circular Linked Lists" , "/algorithms/data-structures/circular-linked-list");
        topics["Data Structures"].Add("Heap", "/algorithms/data-structures/heap");
        topics["Data Structures"].Add("Stack", "/algorithms/data-structures/stack");
        topics["Data Structures"].Add("Queue","/algorithms/data-structures/queue");

        topics.Add("Search Algorithms", new Dictionary<string, string>());
        topics["Search Algorithms"].Add("Monte Carlo Tree Search", "/algorithms/search-algorithms/mcts");
        topics["Search Algorithms"].Add("Minimax", "/algorithms/search-algorithms/minimax");

        topics.Add("Pathfinding Algorithms", new Dictionary<string, string>());
        topics["Pathfinding Algorithms"].Add("A start Search", "/algorithms/pathfinding-algorithms/astar");
        topics["Pathfinding Algorithms"].Add("Breadth First Search", "/algorithms/pathfinding-algorithms/bfs");
        topics["Pathfinding Algorithms"].Add("Depth First Search", "/algorithms/pathfinding-algorithms/dfs");
        topics["Pathfinding Algorithms"].Add("Djikstra's Algorithm", "/algorithms/pathfinding-algorithms/djikstra");
        topics.Add("Optimization Algorithms", new Dictionary<string, string>());
        topics["Optimization Algorithms"].Add("Simmulated Annealing", "/algorithms/optimization-algorithms/simmulated-annealing");
        topics.Add("Graph Drawing Algorithms", new Dictionary<string, string>());
        topics["Graph Drawing Algorithms"].Add("Force Directed Graphs", "/algorithms/graph-drawing-algorithms/force-directed-graph"); 
    }
}

@code {
    private bool _isRotated;
    private string _iconClass => _isRotated ? "rotated": "";

    private void rotateArrow()
    {
        _isRotated = !_isRotated;
        Console.WriteLine($"iconClass {_iconClass}");
    }
}