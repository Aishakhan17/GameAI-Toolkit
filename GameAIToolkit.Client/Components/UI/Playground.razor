@using GameAIToolkit.Client.Components.UI
@rendermode InteractiveWebAssembly

<div>
    <div class="playround-body">
        <div style="position: relative; width: @(Width)px; height: @(Height)px; border: 1px solid #ddd; background: #fafafa; border-radius: 8px; overflow: hidden;">
            <svg style="position: absolute; width: 100%; height: 100%; top: 0; padding: 2px">
                @foreach (var edge in Edges)
                {
                    if (Nodes.TryGetValue(edge.Source, out var s) && Nodes.TryGetValue(edge.Target, out var t))
                    {
                        <line x1="@s.X" y1="@s.Y" x2="@t.X" y2="@t.Y" stroke="#bbb" stroke-width="1.5" />
                    }
                }
                @foreach (var kvp in Nodes)
                {
                    var node = kvp.Value;
                    <g>
                        <circle cx="@node.X" cy="@node.Y" r="12" fill="#80cbc4" stroke = "bbb" stroke-width="2"/>
                        <text x="@node.X" y="@node.Y" font-size="12" font-weight ="bold" text-anchor="middle" fill="000">
                            @node.Id
                        </text>
                    </g>
                }
            </svg>
        </div>
        <div class="sidebar-right diagram-box-background">
            <label><strong>Input</strong></label>
            <div>
                <textarea @bind="rawInput" rows="5" class="textarea font-body" disabled="@(!RendererInfo.IsInteractive)"></textarea><br/>
            </div>
            <MudButton Class="btn-primary" OnClick="UpdateList">Submit</MudButton>
            <MudButton Class="btn-secondary" OnClick="ResetList">Reset</MudButton>
        </div>
    </div>
    <div sm="3" xs="12">
        <div>
            <div>
                <div class="font-code text-align-center middle-vertical-align">
                    Visited
                </div>
                <div class="cells" style="--cell-count: @numNodes">
                    @for (int i = 0; i < numNodes; i++)
                    {
                            <Cell />   
                    }
                </div>
            </div>
            <div>
                <div class="font-code text-align-center middle-vertical-align">
                    Queue
                </div>
                    <div class="cells" style="--cell-count: @numNodes">
                        @for (int i = 0; i < numNodes; i++)
                        {
                            <Cell />
                        }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Dictionary<string, TreeNode.Node> Nodes = new();
    private List<TreeEdge.Edge> Edges = new();
    
    private double Width = 800;
    private double Height = 450;
    private string rawInput {get;set;} = "1: 2,3,4\n2: 1,7\n3: 1,2,6,5\n4: 1,3,5,8\n5: 3,4,6,10,9\n6: 3,7,11,10,5\n7: 2,11,6\n8: 4,9\n9: 8,5,15,16\n10: 6,5,11,12,15\n11: 7,6,10,12,13\n12: 11,10,13,15\n13: 11,12,14\n14: 13,12,15,16\n15: 10,12,14,16,9\n16: 9,15,14";

    List<List<int>> parsedInput = new List<List<int>>();
    // new() {new() {1, 2}, new(){0, 2}, new() {0, 1, 3, 4}, new(){2}, new(){2}ssss};
    private string defaultInput {get; set;} = string.Empty;
    private int numNodes;
    protected override void OnInitialized()
    {
        defaultInput = rawInput;
        ParseInput();
    }
    private void UpdateList()
    {
        @* Console.WriteLine($"updating list {rawInput}" ); *@
        ParseInput();
                @* if (parsedSuccessfully)
        {
            numNodes = parsedInput.Count;
            bfs(parsedInput, numNodes);
        } *@
    }
    private void ResetList()
    {
        rawInput = defaultInput;
        ParseInput();
    }
    private bool ParseInput()
    {
        //bool value to track if raw input has been parsed successfully
        var parsed = false;
        Nodes.Clear();
        Edges.Clear();

        var lines = rawInput.Split(new[] {'\n', '\r'}, StringSplitOptions.RemoveEmptyEntries);
        var random = new Random(42);

        CreateNodesAndEdges(lines, random);
        return parsed;
    }
    private void CreateNodesAndEdges(string[] lines, Random random)
    {
        @* Console.WriteLine($"Parsing"); *@
        CreateNodes(lines, random);
        CreateEdges(lines, random);
        RunForceDirectedGraphLayout();
        foreach (var node in Nodes)
        {
            Console.WriteLine($"node id {node.Value.Id} node value X {node.Value.X} node value Y {node.Value.Y}");
        }
        foreach (var edge in Edges)
        {
            Console.WriteLine($"edge source {edge.Source} edge target {edge.Target}");
        }
    }
    private void CreateNodes(string[] lines, Random random)
    {
        foreach (var line in lines)
        {
            var parts = line.Split(new[] {':'}, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length <1) continue;
            string sourceId = parts[0];
            @* Console.WriteLine($"sourceId {sourceId}"); *@
            if (!Nodes.ContainsKey(sourceId))
            {
                var newNode = new TreeNode.Node
                {
                    Id  = sourceId,
                    X = (Width/2) + (random.NextDouble() + 0.5)*40,
                    Y = (Height/2) + (random.NextDouble() + 0.5)*40

                };
                Nodes[sourceId] = newNode;
            };
        }
    }
    private void CreateEdges(string[] lines, Random random)
    {
        var edgeTracker = new HashSet<string>();
        foreach (var line in lines)
        {
            var parts = line.Split(new[] {':'}, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);   

            if (parts.Length < 2) continue;
            var sourceId = parts[0];
            var targets = parts[1].Split(new[] {','}, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            foreach (var target in targets)
            {
                var targetId = target;
                if (!Nodes.ContainsKey(targetId)) {
                    var newNode = new TreeNode.Node
                    {
                        Id = targetId,
                        X = (Width/2)+(random.NextDouble() + 0.5)*40,
                        Y = (Height/2)+(random.NextDouble() + 0.5)*40
                    };
                    Nodes[targetId] = newNode; 
                }
                var edgeKey = string.Compare(sourceId, targetId) < 0 ? $"{sourceId}-{targetId}":$"{targetId}-{sourceId}";
                if (edgeTracker.Add(edgeKey))
                {
                    @* Console.WriteLine($"edgeKey {edgeKey}"); *@
                    var newEdge = new TreeEdge.Edge
                    {
                        Source = sourceId,
                        Target = targetId
                    };    
                    Edges.Add(newEdge);
                }

            }
        }


    }
    private void RunForceDirectedGraphLayout()
    {
        if (Nodes.Count <= 0) return;
        int iterations = 250; 

        //ideal distance between connected mesh components 
        double k = Math.Sqrt((Width*Height) / Nodes.Count)*0.75;

        //starting temperature 
        double temperature = Width/10.0; 

        //cooling factor
        double coolingFactor = temperature/iterations;   ///Can tweak and experiment with this cooling factor

        for (int iter = 0; iter < iterations; iter++)
        {
            //set all node displacement vectors to zero at the start
            foreach (var node in Nodes.Values)
            {
                node.Fx = 0;
                node.Fy = 0;
            }


            var nodeList = Nodes.Values.ToList();
            for (int i = 0; i< nodeList.Count; i++)
            {
                for (int j = i +1; j< nodeList.Count; j++)
                {
                    var u = nodeList[i];
                    var v = nodeList[j];

                    //v.pos - u.pos
                    double dx = v.X - u.X;
                    double dy = v.Y - u.Y;

                    //calculate (euclidean) distance or | Δ |
                    double distance = Math.Sqrt(dx*dx + dy*dy);

                    if (distance < 0.1) distance = 0.1;  //prevent 0 division

                    //repulsion formula
                    double repulsionForce = -(k*k)/distance;
                    double fx = (dx/distance) * repulsionForce;
                    double fy = (dy/distance) * repulsionForce;

                    //update displacement?

                    u.Fx += fx;
                    u.Fy += fy;

                    v.Fx -= fx;
                    v.Fy -= fy;



                }
            }
            //Apply attractive forces: Hooke's law of spring attraction 
        foreach (var edge in Edges)
        {
            var u = Nodes[edge.Source];
            var v = Nodes[edge.Target];   

            double dx = v.X-u.X; 
            double dy = v.Y-u.Y;

            double distance = Math.Sqrt(dx*dx + dy*dy);
            if (distance < 0.1) distance = 0.1;
            double attractionForce = (distance*distance)/k;

            double fx = (dx/distance)*attractionForce;
            double fy = (dy/distance)*attractionForce;

            u.Fx += fx;
            u.Fy += fy;

            v.Fx -= fx;
            v.Fy -= fy;

        }

        foreach (var node in Nodes.Values)
        {
            var distance = Math.Sqrt(node.Fx*node.Fx+node.Fy*node.Fy);
            if (distance < 0.1) continue;
            var limitDisplacement = Math.Min(distance, temperature);
            node.X += (node.Fx/distance)*limitDisplacement;
            node.Y += (node.Fy/distance)*limitDisplacement;

            //enforce safety boundary
            @* node.X = Math.Min(25, Math.Max(Width/2, node.X));
            node.Y = Math.Min(25, Math.Max(Height/2, node.Y)); *@

            node.X = Math.Max(25, Math.Min(Width - 25, node.X));
            node.Y = Math.Max(25, Math.Min(Height - 25, node.Y));
        }

            temperature -= coolingFactor;
            if (temperature <= 0) break;
            
        }

    }






    static List<int> bfs(List<List<int>> input, int numNodes) 
        {
        //numNodes = adj.Count;
        //initialize an array of bools set to false that will be changes to true when the node is visited 
        bool[] visited = new bool[numNodes];
        //initialize a queue to implement fifo *@
        Queue<int> myQueue = new Queue<int>();
        //initialize a list to hold the nodes in order of traversal 
        List<int> result = new List<int>();

        //initialize a pointer to traverse the input
        int src = 0;
        visited[src] = true;
        myQueue.Enqueue(src);

        while (myQueue.Count > 0) {
            int current = myQueue.Dequeue();
            Console.WriteLine($"current {current}");
            result.Add(current);

            @* foreach (x in input[current])
            {
                if (!visited[x]) {
                    visited[x] = true;
                    myQueue.Enqueue(x);   
                }
            } *@
        }
        foreach (int i in result)
        {
            Console.WriteLine($"i {i}");
        }
        return result;
    }
    
}