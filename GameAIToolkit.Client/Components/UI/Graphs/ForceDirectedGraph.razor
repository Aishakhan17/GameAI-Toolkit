@using GameAIToolkit.Client.Components.UI.Graphs;
@rendermode InteractiveWebAssembly
@layout PlaygroundLayout

<div class="playground-body">
    <section class="panel playground-widget">
        <div class="graph-canvas">
            <svg class="graph-svg" viewBox="0 0 800 450" preserveAspectRatio="xMidYMid meet">
                @foreach (var edge in Edges)
                {
                    if (Nodes.TryGetValue(edge.Source, out var s) && Nodes.TryGetValue(edge.Target, out var t))
                    {
                        <line x1="@s.X" y1="@s.Y" x2="@t.X" y2="@t.Y" stroke="#bbb" stroke-width="1.5" />
                    }
                }
                @foreach (var kvp in Nodes)
                {
                    var node = kvp.Value;
                    <TreeNode @key="node.Id" X="@node.X" Y="@node.Y" radius="12" Id="@node.Id" />
                }
            </svg>
        </div>
        <footer class="player">Player goes here</footer>
    </section>

    <aside class="right-rail">
        <CodeWidget />

        <section class="panel panel--inputs">
            <header class="panel__header">
                <span class="panel__title">Input</span>
            </header>
            <div class="panel__body">
                <textarea @bind="rawInput" rows="5" class="textarea"
                          disabled="@(!RendererInfo.IsInteractive)"></textarea>
            </div>
            <footer class="panel__footer">
                <button class="btn btn-primary" @onclick="UpdateList">Submit</button>
                <button class="btn btn-secondary" @onclick="ResetList">Reset</button>
            </footer>
        </section>

        <section class="panel panel--log">
            <header class="panel__header">
                <span class="panel__title">Log</span>
            </header>
            <div class="panel__body">This is where the logger goes</div>
        </section>
    </aside>
</div>

@code {
    private double Width = 800;
    private double Height = 450;
    
    private string rawInput {get;set;} = "1: 2,3,4\n2: 1,7\n3: 1,2,6,5\n4: 1,3,5,8\n5: 3,4,6,10,9\n6: 3,7,11,10,5\n7: 2,11,6\n8: 4,9\n9: 8,5,15,16\n10: 6,5,11,12,15\n11: 7,6,10,12,13\n12: 11,10,13,15\n13: 11,12,14\n14: 13,12,15,16\n15: 10,12,14,16,9\n16: 9,15,14";

    List<List<int>> parsedInput = new List<List<int>>();
    // new() {new() {1, 2}, new(){0, 2}, new() {0, 1, 3, 4}, new(){2}, new(){2}ssss};
    private string defaultInput {get; set;} = string.Empty;
    private int numNodes;

    protected override void OnInitialized()
    {
        defaultInput = rawInput;

        ParseInput();
    }
    private void UpdateList()
    {
        Console.WriteLine("updating");
        ParseInput();
                @* if (parsedSuccessfully)
        {
            numNodes = parsedInput.Count;
            bfs(parsedInput, numNodes);
        } *@
    }
    private void ResetList()
    {
        Console.WriteLine("resetting");
        rawInput = defaultInput;
        ParseInput();
    }
}